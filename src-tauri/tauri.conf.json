{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MrTyper",
  "version": "1.0.0",
  "identifier": "com.mrtyper.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MrTyper",
        "create": false,
        "width": 1220,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "MrTyper",
    "copyright": "Copyright © 2026 MrTyper",
    "category": "Productivity",
    "shortDescription": "Human-paced typing into any Windows window.",
    "longDescription": "MrTyper types a script into whatever window you focus, with human-like pauses, typo corrections, and customizable speed. Everything stays local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}

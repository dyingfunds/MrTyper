{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MrTyper",
  "version": "../package.json",
  "identifier": "com.mrtyper.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MrTyper",
        "create": false,
        "width": 1220,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "MrTyper",
    "copyright": "Copyright © 2026 MrTyper",
    "category": "public.app-category.productivity",
    "shortDescription": "Human-paced typing into any macOS app.",
    "longDescription": "MrTyper types a script into whatever app you focus, with human-like pauses, typo corrections, and customizable speed. Everything stays local.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIzMjE3MzQxNDM1RjUyNTIKUldSU1VsOURRWE1oczdtaG9EOGJNdll2a2dpSlBrWlZMUnc3UnUwaDAyUDZoNHNMcFdVeEFaaG8K",
      "endpoints": [
        "https://github.com/dyingfunds/MrTyper/releases/latest/download/latest.json"
      ]
    }
  }
}
